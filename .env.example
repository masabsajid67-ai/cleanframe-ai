# CLEANFRAME AI — backend environment. Copy to backend/.env (never commit real keys).
# Frontend NEVER reads this file. GPU keys stay server-side only.

# Storage + retention
CLEANFRAME_STORAGE_DIR=./storage
RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=600

# Uploads
MAX_UPLOAD_MB=500

# OCR
OCR_ENGINE=auto
DETECT_FPS=1.0
MAX_DETECT_FRAMES=90
OCR_MIN_CONFIDENCE=0.45
REVIEW_CONFIDENCE=0.65

# Inpainting
DEFAULT_ENGINE=cpu
INPAINT_PAD_PX=4
INPAINT_RADIUS=3
VIDEO_CRF=18

# Frontend origin(s) allowed to call the API (comma-separated, no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173

# --- ProPainter GPU (optional) ---
# Option A — RunPod serverless (recommended, see GPU.md)
PROPINTER_MODE=runpod
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
# Option B — generic HTTP GPU worker (e.g. Modal web endpoint)
# PROPINTER_MODE=http
# PROPINTER_ENDPOINT_URL=https://your-worker.modal.run
# PROPINTER_API_KEY=
# Option C — local ProPainter checkout on a GPU machine
# PROPINTER_MODE=local
# PROPINTER_LOCAL_DIR=/opt/ProPainter
PROPINTER_TIMEOUT_SECONDS=1800

HOST=0.0.0.0
PORT=8000
